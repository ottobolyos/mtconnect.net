<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MTConnect.NET_Common_Tests</RootNamespace>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libraries\MTConnect.NET-Common\MTConnect.NET-Common.csproj" />
    <!--
      MTConnect.NET-HTTP is referenced from the CA2022 short-read fixtures
      (tests/MTConnect.NET-Common-Tests/Http/), which reflection-inspect
      MTConnectPostResponseHandler.ReadRequestBytes and drive the Ceen
      LimitedBodyStream drain path to pin the CA2022 short-read handling
      contract across every TFM.
    -->
    <ProjectReference Include="..\..\libraries\MTConnect.NET-HTTP\MTConnect.NET-HTTP.csproj" />
    <!--
      MTConnect.NET-TLS is referenced from TlsCertificateLoaderTests.cs
      (tests/MTConnect.NET-Common-Tests/Tls/), which round-trips a
      self-signed PFX through TlsConfiguration.GetCertificate() to pin
      the SYSLIB0057 → X509CertificateLoader migration's behaviour
      equivalence under net9.0.
    -->
    <ProjectReference Include="..\..\libraries\MTConnect.NET-TLS\MTConnect.NET-TLS.csproj" />
  </ItemGroup>

</Project>
